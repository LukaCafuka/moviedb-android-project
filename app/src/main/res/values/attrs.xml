<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Custom attributes for CircularRatingView -->
    <declare-styleable name="CircularRatingView">
        <!-- The rating value (0.0 to 10.0) -->
        <attr name="rating" format="float" />
        <!-- Maximum rating value (default 10.0) -->
        <attr name="maxRating" format="float" />
        <!-- Stroke width for the circular progress -->
        <attr name="strokeWidth" format="dimension" />
        <!-- Background circle color -->
        <attr name="backgroundCircleColor" format="color" />
        <!-- Whether to show the rating text in the center -->
        <attr name="showRatingText" format="boolean" />
        <!-- Text size for the rating number -->
        <attr name="ratingTextSize" format="dimension" />
        <!-- Text color for the rating number -->
        <attr name="ratingTextColor" format="color" />
        <!-- Whether to use dynamic colors based on rating value -->
        <attr name="useDynamicColors" format="boolean" />
    </declare-styleable>
</resources>
